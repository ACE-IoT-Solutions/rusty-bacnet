ARG RUST_IMAGE=rust:1.97.1-bookworm
ARG PYTHON_IMAGE=python:3.11-slim-bookworm

FROM ${RUST_IMAGE} AS builder

ARG SOURCE_SHA=unknown
ARG SOURCE_REF=unknown
ARG SOURCE_ARCHIVE_SHA256=unknown
ARG SOURCE_DIRTY=unknown

RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake python3 python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy

WORKDIR /src
COPY . .
RUN python3 -m venv /build-venv \
    && /build-venv/bin/pip install --no-cache-dir "maturin>=1,<2" \
    && RUSTFLAGS=-Awarnings /build-venv/bin/maturin build \
        --release \
        --manifest-path crates/rusty-bacnet/Cargo.toml \
        --interpreter /build-venv/bin/python \
        --out /dist \
    && sha256sum /dist/rusty_bacnet-*.whl > /dist/wheel.sha256 \
    && { \
        printf 'source_sha=%s\n' "$SOURCE_SHA"; \
        printf 'source_ref=%s\n' "$SOURCE_REF"; \
        printf 'source_archive_sha256=%s\n' "$SOURCE_ARCHIVE_SHA256"; \
        printf 'source_dirty=%s\n' "$SOURCE_DIRTY"; \
        printf 'rustc=%s\n' "$(rustc --version)"; \
        printf 'cargo=%s\n' "$(cargo --version)"; \
        printf 'builder_python=%s\n' "$(/build-venv/bin/python --version 2>&1)"; \
        printf 'maturin=%s\n' "$(/build-venv/bin/maturin --version)"; \
    } > /dist/build-environment.txt

FROM ${PYTHON_IMAGE} AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /dist/rusty_bacnet-*.whl /tmp/
COPY --from=builder /dist/wheel.sha256 /usr/local/share/rusty-bacnet/wheel.sha256
COPY --from=builder /dist/build-environment.txt /usr/local/share/rusty-bacnet/build-environment.txt
RUN python -m pip install --no-cache-dir /tmp/rusty_bacnet-*.whl \
    && rm /tmp/rusty_bacnet-*.whl
COPY crates/rusty-bacnet/tests/container/sc_runtime_fixture.py /fixture.py
COPY crates/rusty-bacnet/tests/container/run-sc-runtime-in-container.sh /run-fixture.sh

ENTRYPOINT ["/run-fixture.sh"]
