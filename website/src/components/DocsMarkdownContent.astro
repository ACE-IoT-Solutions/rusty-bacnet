---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { generatedSearchWeight } from '../lib/site.mjs';

// A page with a generated reference region (between generated:start and
// generated:end markers, written by scripts/reference-*) lists every option,
// method and signature under its own heading, so it matches almost any search
// term. Pagefind counts its body, headings included, at a lower weight, so the
// task guides rank first; the page title keeps its normal weight.
const body = Astro.locals.starlightRoute.entry.body ?? '';
const generated = body.includes('generated:start');
---
{generated
  ? <div data-pagefind-weight={String(generatedSearchWeight)}><Default><slot /></Default></div>
  : <Default><slot /></Default>}
